# Backend .env for production (/opt/osvs/osvs-backend/.env, owner osvs, chmod 600).
# Copy to .env and fill in every <...>. Never commit the real file.

NODE_ENV=production
PORT=4000
APP_NAME=OSVS
APP_URL=https://osvs.se
FRONTEND_URL=https://osvs.se
BACKEND_URL=https://osvs.se
# nginx in front of Express
TRUST_PROXY=1
# Exactly one backend instance runs the mail worker and cron jobs
CRON_RUNNER=true
CSRF_ALLOWED_ORIGINS=https://osvs.se

# MySQL 8.0 on localhost, dedicated app user (see deploy/README.md)
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=osvs
DB_PASS=<db password>
DB_NAME=osvs_prod
DB_CONNECT_TIMEOUT_MS=5000

# Auth: new random secret, e.g. `openssl rand -base64 48`. The backend refuses
# to start in production with a secret under 32 characters or any <...> value
# left from this template (src/config/env.ts checkProductionConfig).
JWT_SECRET=<long random secret>
COOKIE_DOMAIN=
# Same-origin deploy (nginx serves SPA and /api): keep lax.
COOKIE_SAMESITE=lax

# Mail via Websupport (noreply@osvs.se); use the NEW password after rotation
SMTP_HOST=smtp.websupport.se
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=noreply@osvs.se
SMTP_PASS=<smtp password>
MAIL_FROM=OSVS <noreply@osvs.se>
MAIL_RATE_PER_HOUR=250
# Ignored when NODE_ENV=production
MAIL_DEV_ALLOWLIST=

# Geocoding (OpenStreetMap policy: identify the app and a contact address)
NOMINATIM_USER_AGENT=OSVS (https://osvs.se; <contact email>)

# Optional
SENTRY_DSN=
# Slow queries are always logged to the journal; set a path only if you also
# want a separate file (it is not rotated). Unset = no file in production.
#SLOW_QUERY_LOG_PATH=
