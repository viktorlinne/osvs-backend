# Server
PORT=4000
NODE_ENV=development
FRONTEND_URL=http://localhost:5173
BACKEND_URL=http://localhost:4000
TRUST_PROXY=false
CRON_RUNNER=true

# Browser request protection
CSRF_ALLOWED_ORIGINS=

# Database
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_NAME=osvs_dev
# Set DB_PASS explicitly even if your local MySQL password is intentionally blank.
DB_PASS=
DB_CONNECT_TIMEOUT_MS=5000

# Destructive migration gate
MIGRATE_ALLOW_DATA_RESET=false

# Auth / cookies
JWT_SECRET=
ACCESS_EXPIRES=15m
REFRESH_TOKEN_DAYS=30
ACCESS_COOKIE=accessToken
REFRESH_COOKIE=refreshToken
COOKIE_DOMAIN=

# Argon2 password hashing
ARGON2_MEMORY_KB=65536
ARGON2_TIME=3
ARGON2_PARALLELISM=1

# Query logging
SLOW_QUERY_THRESHOLD_MS=200
SLOW_QUERY_LOG_LEVEL=info
SLOW_QUERY_LOG_PATH=tmp/slow-queries.log

# Error monitoring
SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=0.0

# Storage
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_URL=
SUPABASE_BUCKET_POSTS=posts
SUPABASE_BUCKET_PROFILES=profiles
SUPABASE_BUCKET_DOCUMENTS=documents
SUPABASE_BUCKET_REVISIONS=revisions
SUPABASE_BUCKET_STATIC=static
SUPABASE_UPLOAD_EXPIRY_SEC=300

# Geocoding
NOMINATIM_USER_AGENT=
NOMINATIM_TIMEOUT_MS=10000
NOMINATIM_MIN_INTERVAL_MS=1000

# Optional docs metadata
APP_NAME=OSVS API
APP_VERSION=1.0.0
APP_URL=http://localhost:4000

